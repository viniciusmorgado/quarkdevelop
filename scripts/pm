#!/usr/bin/env bash
# Run a command inside the MonoDevelop development container (podman, rootless).
#
#   ./scripts/pm dotnet --info
#   ./scripts/pm bash -lc 'dotnet build main/MonoDevelop.Linux.sln'
#
# The image is built from ./Dockerfile on first use (tagged by the file's hash),
# so the command is idempotent. The repository is mounted at the same absolute path
# it has on the host; for git worktrees the main repository is mounted instead, so
# the worktree's .git indirection keeps working inside the container.
#
# Environment:
#   PM_IMAGE       use this image instead of building ./Dockerfile
#   PM_PODMAN_ARGS extra arguments for `podman run` (word-split)
#   PM_REBUILD=1   force a rebuild of the development image
#   PM_PROFILE     dev (default): ./Dockerfile, image localhost/md-dev
#                  flatpak: packaging/flatpak/Dockerfile, image localhost/md-flatpak, with the
#                  podman options flatpak-builder and `flatpak run` need (bubblewrap sandboxes nested
#                  in the rootless container) and the md-flatpak volume (ADR 0022)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Resolve the directory to mount: the repository root, or the main repository when
# $here is a git worktree (.git is then a file: "gitdir: <main>/.git/worktrees/<name>").
mount_root="$here"
if [[ -f "$here/.git" ]]; then
	gitdir="$(sed -n 's/^gitdir: //p' "$here/.git")"
	case "$gitdir" in
		*/.git/worktrees/*) mount_root="${gitdir%/.git/worktrees/*}" ;;
	esac
fi

profile_args=()
case "${PM_PROFILE:-dev}" in
	dev)
		Dockerfile="$here/Dockerfile"
		image_name=localhost/md-dev
		;;
	flatpak)
		Dockerfile="$here/packaging/flatpak/Dockerfile"
		image_name=localhost/md-flatpak
		# bubblewrap (flatpak-builder, flatpak run) mounts a new /proc in its sandbox; the kernel refuses
		# that while podman masks paths under /proc, hence unmask=/proc/*. Nothing else is needed: no
		# capabilities (bwrap refuses to run unprivileged with extra capabilities), default seccomp, no
		# /dev/fuse (flatpak-builder runs with --disable-rofiles-fuse). Runtimes and caches: md-flatpak.
		profile_args=(
			-v md-flatpak:/var/lib/md-flatpak
			--security-opt 'unmask=/proc/*'
		)
		;;
	*)
		echo "pm: unknown PM_PROFILE '${PM_PROFILE}' (dev, flatpak)" >&2
		exit 2
		;;
esac

image="${PM_IMAGE:-}"
if [[ -z "$image" ]]; then
	hash="$(sha256sum "$Dockerfile" | cut -c1-12)"
	image="$image_name:$hash"
	if [[ "${PM_REBUILD:-0}" == 1 ]] || ! podman image exists "$image"; then
		echo "pm: building $image" >&2
		podman build --pull=newer -t "$image" -f "$Dockerfile" "$here" >&2
		podman tag "$image" "$image_name:latest"
	fi
fi

tty_args=()
if [[ -t 0 && -t 1 ]]; then
	tty_args=(-it)
elif [[ ! -t 0 ]]; then
	# stdin is a pipe/file (e.g. a heredoc script): forward it to the container.
	tty_args=(-i)
fi

# shellcheck disable=SC2206
extra_args=(${PM_PODMAN_ARGS:-})

workdir="$PWD"
case "$workdir" in
	"$mount_root"|"$mount_root"/*) ;;
	*) workdir="$here" ;;
esac

# --init: a minimal init is PID 1, so the command gets default signal handling and zombies are reaped
# (xvfb-run as PID 1 never saw Xvfb's ready signal and hung, e.g. `exec xvfb-run` in scripts/run.sh).
exec podman run --rm --init "${tty_args[@]}" \
	--userns=keep-id \
	--security-opt label=disable \
	-v "$mount_root:$mount_root" \
	-v md-home:/home/dev \
	-e HOME=/home/dev \
	-e DOTNET_CLI_TELEMETRY_OPTOUT=1 \
	-e DOTNET_NOLOGO=1 \
	-e NUGET_PACKAGES=/home/dev/.nuget/packages \
	-w "$workdir" \
	"${profile_args[@]}" \
	"${extra_args[@]}" \
	"$image" "$@"
