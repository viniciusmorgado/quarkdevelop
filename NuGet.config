<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the Linux / .NET 10 build (ADR 0004). The legacy myget, appveyor and
  dotnetfeed sources are dead and were removed; see docs/adr/0004-central-package-management-and-feeds.md.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
