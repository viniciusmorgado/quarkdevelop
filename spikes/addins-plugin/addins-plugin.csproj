<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SamplePlugin</AssemblyName>
    <OutputPath>../addins-host/bin/$(Configuration)/net10.0/AddIns/SamplePlugin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../addins-host/addins-host.csproj" Private="false" />
    <PackageReference Include="Mono.Addins" Version="1.4.1" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SamplePlugin.addin.xml" LogicalName="SamplePlugin.addin.xml" />
  </ItemGroup>
</Project>
