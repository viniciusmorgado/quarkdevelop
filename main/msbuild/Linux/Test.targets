<Project>
  <!--
    Test projects (IsTestProject=true): every test host gets the MSBuild-locator startup hook through a
    generated .runsettings (ADR 0008/0015), and the shared UnitTests infrastructure.
  -->
  <PropertyGroup>
    <MDTestRunSettings>$(BaseIntermediateOutputPath)monodevelop.runsettings</MDTestRunSettings>
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MDTestRunSettings)</RunSettingsFilePath>
    <!-- Coverlet resolves the references of instrumented assemblies from the deps.json; MSBuild is
         referenced compile-only (ADR 0008), so keep the compile references there (T055). -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'TestStartupHook'">
    <ProjectReference Include="$(MonoDevelopRootDir)tests/TestStartupHook/TestStartupHook.csproj" />
  </ItemGroup>

  <Target Name="WriteMonoDevelopRunSettings" BeforeTargets="Build" Condition="'$(RunSettingsFilePath)' == '$(MDTestRunSettings)'">
    <PropertyGroup>
      <!-- A hung test (e.g. waiting for a build that cannot run) fails instead of aborting the run. -->
      <_MDNUnitSettings><![CDATA[<DefaultTimeout>120000</DefaultTimeout>]]></_MDNUnitSettings>
      <!--
        MDTestSingleThread=true: every test runs on the thread of the set-up fixtures, as under GuiUnit (the GTK
        editor checks that it is used from the thread that created it). No NUnit test workers, and no per-test
        timeout: NUnit runs a test with a timeout on another thread.
      -->
      <_MDNUnitSettings Condition="'$(MDTestSingleThread)' == 'true'"><![CDATA[<NumberOfTestWorkers>0</NumberOfTestWorkers>]]></_MDNUnitSettings>
      <_MDRunSettings><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>$(MonoDevelopRepoRoot)out/tests</ResultsDirectory>
    <EnvironmentVariables>
      <DOTNET_STARTUP_HOOKS>$(MonoDevelopBuildDir)tests/MonoDevelop.TestStartupHook.dll</DOTNET_STARTUP_HOOKS>
      <MONODEVELOP_TEST_ROOT>$(MonoDevelopRootDir)tests</MONODEVELOP_TEST_ROOT>
      <MONODEVELOP_MSBUILD_BUILDER>$(MonoDevelopBuildDir)bin/MonoDevelop.MSBuildBuilder.dll</MONODEVELOP_MSBUILD_BUILDER>
      <!-- MonoDevelop profile (add-in registry cache, config) of this checkout: the container home is shared by
           all worktrees, and a registry left by another checkout made C# projects load as unknown items. -->
      <XDG_CONFIG_HOME>$(MonoDevelopRepoRoot)out/test-profile/config</XDG_CONFIG_HOME>
      <XDG_DATA_HOME>$(MonoDevelopRepoRoot)out/test-profile/data</XDG_DATA_HOME>
      <XDG_CACHE_HOME>$(MonoDevelopRepoRoot)out/test-profile/cache</XDG_CACHE_HOME>
    </EnvironmentVariables>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Coverage counts MonoDevelop product assemblies only: vendored third-party code,
               tests and test helpers are not measured. -->
          <Exclude>[Xwt]*,[Xwt.*]*,[Microsoft.VisualStudio.*]*,[Mono.Addins.GuiGtk3]*,[MonoDevelop.Wpf.Primitives]*,[Mono.Debugging]*,[UnitTests]*,[*.Tests]*,[*.Tests.*]*,[MonoDevelop.TestStartupHook]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
  <NUnit>
    ]]>$(_MDNUnitSettings)<![CDATA[
  </NUnit>
</RunSettings>
]]></_MDRunSettings>
    </PropertyGroup>
    <WriteLinesToFile File="$(MDTestRunSettings)" Lines="$(_MDRunSettings)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
