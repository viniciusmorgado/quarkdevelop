<Project>
  <!--
    Shared targets/properties for SDK-style projects of the Linux build, imported by
    main/Directory.Build.targets after the project body so project-set properties
    (AddinBuildDir, MDOutputKind) are visible.

    The output layout is set in OutputLayout.targets (imported before the SDK targets).
  -->
  <PropertyGroup Condition="'$(AddinBuildDir)' != '' and '$(IsTestProject)' != 'true'">
    <!-- Add-ins share the host's dependencies; do not copy the NuGet closure next to each add-in. -->
    <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Friend assemblies are signed with the MonoDevelop public key. -->
  <ItemDefinitionGroup>
    <InternalsVisibleTo>
      <Key Condition="'%(InternalsVisibleTo.Key)' == ''">$(MonoDevelopPublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <!-- Keep embedded resource names short (legacy convention: %(Filename)%(Extension)). -->
  <ItemDefinitionGroup Condition="'$(ShortEmbeddedResourceIDs)' != 'false'">
    <EmbeddedResource>
      <LogicalName Condition="'%(EmbeddedResource.LogicalName)' == ''">%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemDefinitionGroup>

  <Import Project="$(MSBuildThisFileDirectory)warning-baselines/$(MSBuildProjectName).props" Condition="Exists('$(MSBuildThisFileDirectory)warning-baselines/$(MSBuildProjectName).props')" />

  <Import Project="$(MSBuildThisFileDirectory)Test.targets" Condition="'$(IsTestProject)' == 'true'" />

  <Import Project="$(MSBuildThisFileDirectory)BuildVariables.targets" Condition="'$(GenerateMonoDevelopBuildVariables)' == 'true'" />
</Project>
