<Project>
  <!--
    Shared targets/properties for SDK-style projects of the Linux build, imported by
    main/Directory.Build.targets after the project body so project-set properties
    (AddinBuildDir, MDOutputKind) are visible.

    The output layout is set in OutputLayout.targets (imported before the SDK targets).
  -->
  <PropertyGroup Condition="'$(AddinBuildDir)' != '' and '$(IsTestProject)' != 'true'">
    <!-- Add-ins share the host's dependencies; do not copy the NuGet closure next to each add-in. -->
    <CopyLocalLockFileAssemblies Condition="'$(CopyLocalLockFileAssemblies)' == ''">false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Nor the host's project closure: project references of add-ins, including the transitive ones the SDK
    adds (Ide -> Xwt.Gtk3, vs-editor-api, ...), are not copied unless the project sets Private="true".
  -->
  <ItemDefinitionGroup Condition="'$(AddinBuildDir)' != '' and '$(IsTestProject)' != 'true'">
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!--
    NuGet client (ADR 0020): the NuGet assemblies the .NET SDK carries load from the SDK directory at run time (MSBuild
    locator), like MSBuild (ADR 0008), so that the IDE process has the same NuGet as MSBuild's NuGetSdkResolver. Every
    MonoDevelop project gets them compile-only: a direct ExcludeAssets="runtime" reference keeps them out of the output
    and the deps.json of the hosts and test hosts, whichever package brings them in (Microsoft.TemplateEngine.Edge,
    NuGet.PackageManagement). Projects may list them themselves with the same metadata.
  -->
  <ItemGroup Condition="'$(MDNuGetClientFromSdk)' != 'false' and ($([System.String]::Copy('$(MSBuildProjectDirectory)/').StartsWith('$(MonoDevelopRootDir)src/')) or $([System.String]::Copy('$(MSBuildProjectDirectory)/').StartsWith('$(MonoDevelopRootDir)tests/')))">
    <_MDNuGetClientFromSdk Include="NuGet.Commands;NuGet.Common;NuGet.Configuration;NuGet.Credentials;NuGet.DependencyResolver.Core;NuGet.Frameworks;NuGet.LibraryModel;NuGet.Packaging;NuGet.ProjectModel;NuGet.Protocol;NuGet.Versioning" />
    <_MDNuGetClientFromSdk Remove="@(PackageReference)" />
    <PackageReference Include="@(_MDNuGetClientFromSdk)" ExcludeAssets="runtime" PrivateAssets="all" />
    <_MDNuGetClientFromSdk Remove="@(_MDNuGetClientFromSdk)" />
  </ItemGroup>

  <!-- Friend assemblies are signed with the MonoDevelop public key. -->
  <ItemDefinitionGroup>
    <InternalsVisibleTo>
      <Key Condition="'%(InternalsVisibleTo.Key)' == ''">$(MonoDevelopPublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <!-- Keep embedded resource names short (legacy convention: %(Filename)%(Extension)). -->
  <ItemDefinitionGroup Condition="'$(ShortEmbeddedResourceIDs)' != 'false'">
    <EmbeddedResource>
      <LogicalName Condition="'%(EmbeddedResource.LogicalName)' == ''">%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemDefinitionGroup>

  <Import Project="$(MSBuildThisFileDirectory)warning-baselines/$(MSBuildProjectName).props" Condition="Exists('$(MSBuildThisFileDirectory)warning-baselines/$(MSBuildProjectName).props')" />

  <Import Project="$(MSBuildThisFileDirectory)Test.targets" Condition="'$(IsTestProject)' == 'true'" />

  <Import Project="$(MSBuildThisFileDirectory)BuildVariables.targets" Condition="'$(GenerateMonoDevelopBuildVariables)' == 'true'" />
</Project>
