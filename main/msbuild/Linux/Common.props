<Project>
  <!--
    Shared properties for SDK-style projects of the Linux / .NET 10 build (ADR 0003).
    Imported by main/Directory.Build.props before the project body, only when
    UsingMicrosoftNETSdk is true. Legacy csproj files never see this file.
  -->
  <PropertyGroup>
    <MonoDevelopRootDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</MonoDevelopRootDir>
    <MonoDevelopRepoRoot>$([MSBuild]::NormalizeDirectory('$(MonoDevelopRootDir)', '..'))</MonoDevelopRepoRoot>
    <MonoDevelopBuildDir>$(MonoDevelopRootDir)build/</MonoDevelopBuildDir>
    <BeforeMicrosoftNETSdkTargets>$(BeforeMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)OutputLayout.targets</BeforeMicrosoftNETSdkTargets>

    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">8.0</LangVersion>
    <Nullable Condition="'$(Nullable)' == ''">disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Source trees contain files that must not compile on Linux; projects list their sources (ADR 0003). -->
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems Condition="'$(EnableDefaultEmbeddedResourceItems)' == ''">false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems Condition="'$(EnableDefaultNoneItems)' == ''">false</EnableDefaultNoneItems>
    <!--
      Legacy projects carry their own AssemblyInfo.cs. Keep GenerateAssemblyInfo=true (the SDK only
      emits InternalsVisibleTo items when it is true) but turn off every attribute they already define.
    -->
    <GenerateAssemblyInfo Condition="'$(GenerateAssemblyInfo)' == ''">true</GenerateAssemblyInfo>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <GenerateRepositoryUrlAttribute>false</GenerateRepositoryUrlAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- GNOME;LINUX were the defines of the old DebugGnome/ReleaseGnome configurations. -->
    <DefineConstants>$(DefineConstants);GNOME;LINUX;NETCOREAPP_MD</DefineConstants>

    <!-- Assembly identity continuity: keep public signing with the MonoDevelop public key. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MonoDevelopRootDir)msbuild/MonoDevelop-Public.snk</AssemblyOriginatorKeyFile>
    <MonoDevelopPublicKey></MonoDevelopPublicKey>

    <!-- Reproducible restores and security audit (ADR 0004, constitution III/VII). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>

    <!-- Analyzers (constitution V): SDK analyzers on; warnings baseline handled per project. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!--
      Missing XML doc comments are not tracked (the legacy code base never enforced them).
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- New warnings are errors; legacy IDs are listed per project in warning-baselines/ (see scripts/warnings-baseline.sh). -->
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == ''">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
</Project>
