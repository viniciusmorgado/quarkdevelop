<Project>
  <!--
    Generates MonoDevelop.BuildInfo (BuildVariables.cs) from version.config without running
    configure.exe under Mono (ADR 0003). Used by MonoDevelop.Core
    (<GenerateMonoDevelopBuildVariables>true</GenerateMonoDevelopBuildVariables>).
    Also writes build/bin/buildinfo with the git revision, as the legacy build did.
  -->
  <PropertyGroup>
    <MonoDevelopVersionConfig>$(MonoDevelopRepoRoot)version.config</MonoDevelopVersionConfig>
    <MonoDevelopBuildVariablesFile>$(IntermediateOutputPath)BuildVariables.cs</MonoDevelopBuildVariablesFile>
    <CoreCompileDependsOn>GenerateMonoDevelopBuildVariables;$(CoreCompileDependsOn)</CoreCompileDependsOn>
  </PropertyGroup>

  <Target Name="GenerateMonoDevelopBuildVariables"
          DependsOnTargets="PrepareForBuild"
          Inputs="$(MonoDevelopVersionConfig);$(MSBuildThisFileFullPath)"
          Outputs="$(MonoDevelopBuildVariablesFile)">
    <ReadLinesFromFile File="$(MonoDevelopVersionConfig)">
      <Output TaskParameter="Lines" ItemName="_MDVersionConfigLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_MDVersionConfigText>@(_MDVersionConfigLine, '%0A')</_MDVersionConfigText>
      <_MDVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_MDVersionConfigText)', '(?m)^Version=(.*)$').Groups[1].Value.Trim())</_MDVersion>
      <_MDLabel>$([System.Text.RegularExpressions.Regex]::Match('$(_MDVersionConfigText)', '(?m)^Label=(.*)$').Groups[1].Value.Trim())</_MDLabel>
      <_MDLabel Condition="'$(MONODEVELOP_UPDATEINFO_LABEL)' != ''">$(MONODEVELOP_UPDATEINFO_LABEL)</_MDLabel>
      <_MDCompatVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_MDVersionConfigText)', '(?m)^CompatVersion=(.*)$').Groups[1].Value.Trim())</_MDCompatVersion>
      <_MDFullVersion>$([System.Version]::Parse('$(_MDVersion)').ToString())</_MDFullVersion>
      <_MDBuildVariablesContent><![CDATA[// <auto-generated> by main/msbuild/Linux/BuildVariables.targets from version.config </auto-generated>
namespace MonoDevelop
{
	public static class BuildInfo
	{
		public const string Version = "$(_MDVersion)"%3B
		public const string VersionLabel = "$(_MDLabel)"%3B
		public const string CompatVersion = "$(_MDCompatVersion)"%3B
		public const string FullVersion = "$(_MDFullVersion)"%3B

		internal const string BuildLane = "$(BUILD_LANE)"%3B
	}
}
]]></_MDBuildVariablesContent>
    </PropertyGroup>
    <Error Condition="'$(_MDVersion)' == ''" Text="Could not read Version from $(MonoDevelopVersionConfig)" />
    <WriteLinesToFile File="$(MonoDevelopBuildVariablesFile)" Lines="$(_MDBuildVariablesContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(MonoDevelopBuildVariablesFile)" />
    </ItemGroup>
  </Target>

  <Target Name="AddMonoDevelopBuildVariablesToCompile" BeforeTargets="CoreCompile" DependsOnTargets="GenerateMonoDevelopBuildVariables">
    <ItemGroup>
      <Compile Remove="$(MonoDevelopBuildVariablesFile)" />
      <Compile Include="$(MonoDevelopBuildVariablesFile)" />
    </ItemGroup>
  </Target>

  <Target Name="WriteMonoDevelopBuildInfo" AfterTargets="Build" Condition="'$(OutDir)' != ''">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MDGitRevision" />
    </Exec>
    <WriteLinesToFile File="$(OutDir)buildinfo" Lines="$(_MDGitRevision)" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'$(_MDGitRevision)' != ''" />
  </Target>
</Project>
