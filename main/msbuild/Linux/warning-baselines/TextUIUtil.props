<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of TextUIUtil that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1510;CA1805;CA1824;SYSLIB0003;SYSLIB0004</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
