<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of MonoDevelop.MSBuildBuilder that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1001;CA1305;CA1715;CA1822;CA1834;CA1846;CA1852;CA1859;CA2201;CS0672</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
