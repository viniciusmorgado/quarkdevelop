<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of CoreUtility that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1000;CA1051;CA1305;CA1710;CA1711;CA1715;CA1725;CA1859;CA1864;SYSLIB0003;SYSLIB0004</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
