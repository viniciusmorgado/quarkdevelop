       Any other warning ID is an error. Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1010;CA1016;CA1852;CS0612</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
