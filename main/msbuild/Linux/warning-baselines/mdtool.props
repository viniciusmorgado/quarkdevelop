<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of mdtool that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1304;CA1311;CA1852</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
