<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of MonoDevelop.VersionControl.Git.Tests that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1001;CA1051;CA1305;CA1822;CA1861;VSTHRD103;VSTHRD200</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
