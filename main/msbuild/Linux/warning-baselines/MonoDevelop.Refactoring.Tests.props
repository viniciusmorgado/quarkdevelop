  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of MonoDevelop.Refactoring.Tests that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1051;CA1822;VSTHRD003;VSTHRD101;VSTHRD200</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
