<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of MonoDevelop.DotNetCore.Tests that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1001;CA1310;CA1707;CA1822;CA1852;CA1859;VSTHRD003;VSTHRD103;VSTHRD200</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
