<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of MonoDevelop.DotNetCore that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1001;CA1305;CA1806;CA1816;CA1822;CA1859;CA1863;CA2249;CS0612;VSTHRD002;VSTHRD100;VSTHRD103;VSTHRD110;VSTHRD200</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
