<Project>
  <!-- Generated by scripts/warnings-baseline.sh — legacy warning IDs of GnomePlatform that stay warnings.
       Any other warning ID is an error (constitution V). Shrink this list over time. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1305;CA1310;CA1725;CA1822;CA2249;CA2263</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
