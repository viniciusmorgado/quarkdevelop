<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003): the IDE test infrastructure
    (IdeTestBase, TextEditorExtensionTestBase, mock shell) on NUnit 3 (ADR 0015, T107). GuiTestHost replaces GuiUnit:
    GTK, the runtime and Xwt on the NUnit test thread, which runs the GLib main loop while NUnit waits for async
    tests (NUnitMessagePump.cs). Test projects using it set MDTestSingleThread and call GuiTestHost from a set-up
    fixture.
  -->
  <PropertyGroup>
    <AssemblyName>IdeUnitTests</AssemblyName>
    <RootNamespace>IdeUnitTests</RootNamespace>
    <!-- A library, not a test host: its own folder, out of build/bin and of the shared headless test folder. -->
    <MDOutDir>$(MonoDevelopBuildDir)tests/IdeUnitTests/</MDOutDir>
    <!-- Legacy setting: this contains tests for many deprecated editor APIs. -->
    <NoWarn>$(NoWarn);618;612</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="IdeTestBase.cs" />
    <Compile Include="TextEditorExtensionTestBase.cs" />
    <Compile Include="TypeSystemServiceTestExtensions.cs" />
    <Compile Include="TestViewContent.cs" />
    <Compile Include="RoslynTestBase.cs" />
    <Compile Include="CompositionManagerTestHelpers.cs" />
    <Compile Include="ProjectTemplateTest.cs" />
    <Compile Include="ServiceHelper.cs" />
    <Compile Include="MockShell.cs" />
    <Compile Include="MockShellWindow.cs" />
    <Compile Include="MockProgressMonitorManager.cs" />
    <Compile Include="MockOutputProgressMonitor.cs" />
    <Compile Include="MockOperationConsole.cs" />
    <Compile Include="MockShellNotebook.cs" />
    <Compile Include="MockShellDocumentViewContent.cs" />
    <Compile Include="MockShellDocumentViewContainer.cs" />
    <Compile Include="MockShellDocumentView.cs" />
    <Compile Include="MockShellDocumentToolbar.cs" />
    <Compile Include="MockViewBuilder.cs" />
    <Compile Include="GuiTestHost.cs" />
    <Compile Include="NUnitMessagePump.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../src/core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../UnitTests/UnitTests.csproj" />
    <!--
      The editor platform implementation assemblies the Ide add-in lists for the MEF composition
      (/MonoDevelop/Ide/Composition): nothing references them in the product (the IDE finds them in build/bin), so they
      are referenced here to be copied to every test host that uses IdeUnitTests.
    -->
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Core/Impl/CoreUtilityImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Language/Impl/Language/LanguageImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/ClassificationAggregator/ClassificationAggregatorImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/ClassificationType/ClassificationTypeImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/Commanding/CommandingImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/DifferenceAlgorithm/DifferenceAlgorithmImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/EditorOperations/EditorOperationsImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/EditorOptions/EditorOptionsImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/EditorPrimitives/EditorPrimitivesImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/Navigation/NavigationImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/Outlining/Outlining.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/PatternMatching/PatternMatchingImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/StandaloneUndo/StandaloneUndoImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/TagAggregator/TagAggregatorImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/TextBufferUndoManager/TextBufferUndoManagerImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/TextModel/TextModelImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/TextSearch/TextSearchImpl.csproj" />
    <ProjectReference Include="../../vendor/vs-editor-api/src/Editor/Text/Impl/XPlat/MultiCaretImpl/MultiCaretImpl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
