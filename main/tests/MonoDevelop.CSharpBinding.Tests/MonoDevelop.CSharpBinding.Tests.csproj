<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003): the C# binding tests on NUnit 3
    (ADR 0015, T107), run under Xvfb in the IDE test host (IdeUnitTests.GuiTestHost, CSharpBindingTestsSetUp.cs).
  -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.CSharpBinding.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.CSharpBinding.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <!-- The IDE is used from one thread, the one that initialized GTK and the runtime (Test.targets). -->
    <MDTestSingleThread>true</MDTestSingleThread>
    <!-- Legacy setting: this contains many tests for the deprecated old editor APIs. -->
    <NoWarn>$(NoWarn);618;612</NoWarn>
    <!-- Publicizer adds IgnoresAccessChecksToAttribute, which MonoDevelop.Ide also defines and exposes to this assembly
         (InternalsVisibleTo); the local definition is the one used. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Features/ParameterHinting/ParameterHintingTests.cs" />
    <Compile Include="Features/InspectionActionTestBase.cs" />
    <Compile Include="Features/IndentationTests/AlignmentTests.cs" />
    <Compile Include="Features/IndentationTests/BlockTest.cs" />
    <Compile Include="Features/IndentationTests/CommentTests.cs" />
    <Compile Include="Features/IndentationTests/GeneralTests.cs" />
    <Compile Include="Features/IndentationTests/Helper.cs" />
    <Compile Include="Features/IndentationTests/PreProcessorTests.cs" />
    <Compile Include="Features/IndentationTests/StringTests.cs" />
    <Compile Include="Features/IndentationTests/TextPasteIndentEngineTests.cs" />
    <Compile Include="Features/TestBase.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CSharpCompletionTextEditorTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CSharpCompilerParametersTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CSharpProjectPropertiesTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CSharpTextEditorIndentationTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/FindMemberVisitorTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/MonodevelopWorkspaceTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/ModernLanguageVersionTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/NamedArgumentCompletionTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Refactoring/CSharpFindReferencesProviderTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Refactoring/GenerateNewMemberTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/PolicyTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/ExpandSelectionHandlerTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Parser/CSharpParsedDocumentTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CSharpLanguageVersionHelperTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Refactoring/CSharpCodeActionEditorExtensionTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Refactoring/CSharpResultsEditorExtensionTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding.Debugging/DebuggerCompletionControllerTests.cs" />
    <Compile Include="MonoDevelop.CSharpBinding/CustomProjectRuleSetTests.cs" />
    <Compile Include="CSharpBindingTestsSetUp.cs" />
  </ItemGroup>

  <!--
    Not compiled: tests of features removed from the C# binding on Roslyn 5.9 (docs/BREAKING-CHANGES.md, T089):
    - Features/Completion/{Cast,EnumMember,Delegate,EventSender,FormatItem,PreProcessor}CompletionProviderTests.cs,
      ProtocolMemberCompletionTests.cs and their base AbstractCSharpCompletionProviderTests.cs: MonoDevelop's additional
      Roslyn completion providers ("C# completion extras"), not compiled in CSharpBinding.
    - MonoDevelop.CSharpBinding/CSharpDocumentOptionsProviderTests.cs: the C# formatting policies as Roslyn document options
      (IDocumentOptionsProvider, removed in Roslyn 4+).
    - MonoDevelop.CSharpBinding/AutoFormatIntegrationTests.cs: formatting while typing (on semicolon, close brace, return)
      with the project's formatting policies; Roslyn applies .editorconfig instead ("C# project formatting policies as
      Roslyn document options" and "C# format on return").
    - MonoDevelop.CSharpBinding/UnitTesteditorIntegrationTests.cs: the NUnit test markers of MonoDevelop.UnitTesting (not
      ported; T101).
    - MonoDevelop.CSharpBinding/AutomaticBracketInsertionTests.cs: not compiled in the legacy project either.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../src/core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../UnitTests/UnitTests.csproj" />
    <ProjectReference Include="../IdeUnitTests/IdeUnitTests.csproj" />
    <ProjectReference Include="../Ide.Tests/MonoDevelop.Ide.Tests.csproj" />
    <ProjectReference Include="../MonoDevelop.Refactoring.Tests/MonoDevelop.Refactoring.Tests.csproj" />
    <ProjectReference Include="../../src/addins/CSharpBinding/CSharpBinding.csproj" />
    <ProjectReference Include="../../src/addins/MonoDevelop.Refactoring/MonoDevelop.Refactoring.csproj" />
    <ProjectReference Include="../../src/addins/MonoDevelop.SourceEditor2/MonoDevelop.SourceEditor.csproj" />
    <ProjectReference Include="../../src/addins/MonoDevelop.Debugger/MonoDevelop.Debugger.csproj" />
    <ProjectReference Include="../../vendor/debugger-libs/Mono.Debugging/Mono.Debugging.csproj" />
    <!-- Only so that the add-in dependencies of CSharpBinding (Refactoring -> RegexToolkit) resolve in the test registry. -->
    <ProjectReference Include="../../src/addins/MonoDevelop.RegexToolkit/MonoDevelop.RegexToolkit.csproj" />
    <!-- The Linux platform service of the IDE (MIME types of the test documents). -->
    <ProjectReference Include="../../src/addins/GnomePlatform/GnomePlatform.csproj" />
    <!-- NRefactory 5 is removed (ADR 0019) and MonoDevelop.UnitTesting is not ported (T101): not referenced. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.ComponentModel.Composition" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- The tests use Roslyn internals, as the C# binding does (ADR 0010). -->
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Microsoft.CodeAnalysis" />
    <Publicize Include="Microsoft.CodeAnalysis.CSharp" />
    <Publicize Include="Microsoft.CodeAnalysis.Workspaces" />
    <Publicize Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <Publicize Include="Microsoft.CodeAnalysis.Features" />
    <Publicize Include="Microsoft.CodeAnalysis.CSharp.Features" />
  </ItemGroup>
</Project>
