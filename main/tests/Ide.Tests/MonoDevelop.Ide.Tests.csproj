    Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003): the MonoDevelop.Ide tests on
    NUnit 3 (ADR 0015, T107), run under Xvfb. GuiUnit and mdtool run-md-tests are replaced by IdeUnitTests.GuiTestHost
    (IdeTestsSetUp.cs): GTK, the runtime and the add-ins of this output folder, with the GLib main loop on the test thread.
  -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.Ide.Tests</AssemblyName>
    <RootNamespace>Ide.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <!-- The IDE is used from one thread, the one that initialized GTK and the runtime (Test.targets). -->
    <MDTestSingleThread>true</MDTestSingleThread>
    <!-- Legacy setting: this contains tests for many deprecated editor APIs. -->
    <NoWarn>$(NoWarn);618;612</NoWarn>
    <!-- Publicizer adds IgnoresAccessChecksToAttribute, which MonoDevelop.Ide also defines and exposes to this assembly
         (InternalsVisibleTo); the local definition is the one used. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

