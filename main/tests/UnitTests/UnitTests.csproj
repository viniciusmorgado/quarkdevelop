<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared test infrastructure (TestBase, Util, TestHost). SDK-style / net10.0 on NUnit 3.14
    (ADR 0015); GuiUnit and the mdtool test runner are no longer used.
  -->
  <PropertyGroup>
    <AssemblyName>UnitTests</AssemblyName>
    <RootNamespace>UnitTests</RootNamespace>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <!-- Shared test output directory, as in MonoDevelop 8.6 (Util.TestsRootDir relies on it). -->
    <MDOutDir>$(MonoDevelopBuildDir)tests/</MDOutDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Util.cs" />
    <Compile Include="TestBase.cs" />
    <Compile Include="TestHost.cs" />
    <Compile Include="TestSingleThreadSynchronizationContext.cs" />
    <Compile Include="ObjectReference.cs" />
    <Compile Include="RequireServiceAttribute.cs" />
    <Compile Include="CapturingCrashReporter.cs" />
    <Compile Include="CapturingLogger.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tells Mono.Addins (startup directory = test output) where the add-ins are. -->
    <None Include="MonoDevelop.Tests.addins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="Mono.Addins" />
    <!-- The add-in scanner needs the Cecil reflector on CoreCLR (reflection-only loading is gone). -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
  </ItemGroup>
</Project>
