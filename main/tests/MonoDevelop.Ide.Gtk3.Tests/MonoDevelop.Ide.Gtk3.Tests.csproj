<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for code of MonoDevelop.Ide and the source editor add-in changed by the GTK3 / .NET 10 port
    (tasks T136, T085/T088), run under Xvfb.
    The legacy Ide test suites join in M5c (T107).
  -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.Ide.Gtk3.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.Ide.Gtk3.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../../src/addins/GnomePlatform/GnomePlatform.csproj" />
    <!-- The GTK 3 source editor (T085/T088, SourceEditorTests). -->
    <ProjectReference Include="../../src/addins/MonoDevelop.SourceEditor2/MonoDevelop.SourceEditor.csproj" />
    <!-- The GTK C# binding on Roslyn 5.9 (T089, CSharpBindingTests). -->
    <ProjectReference Include="../../src/addins/CSharpBinding/CSharpBinding.csproj" />
    <!-- Only so that the add-in dependencies of CSharpBinding (Refactoring -> RegexToolkit) resolve in the test registry. -->
    <ProjectReference Include="../../src/addins/MonoDevelop.RegexToolkit/MonoDevelop.RegexToolkit.csproj" />
    <!-- The assembly browser on ICSharpCode.Decompiler 11 (T093, AssemblyBrowserTests). -->
    <ProjectReference Include="../../src/addins/MonoDevelop.AssemblyBrowser/MonoDevelop.AssemblyBrowser.csproj" />
    <!-- The Gettext add-in without Autotools/Deployment (T098, GettextTests). -->
    <ProjectReference Include="../../src/addins/MonoDevelop.Gettext/MonoDevelop.Gettext.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <!-- Mono.Addins scans add-ins with Cecil on .NET (SourceEditorTests initialize the MonoDevelop runtime). -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The output of `dotnet new list` (all columns) of SDK 10.0.401 (T152, DotNetNewTemplateTests). -->
    <None Include="TestData/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
