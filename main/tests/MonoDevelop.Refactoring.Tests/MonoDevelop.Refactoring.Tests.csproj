<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003); NUnit 3 (ADR 0015, T090). -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.Refactoring.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.Refactoring.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <!-- Publicizer adds IgnoresAccessChecksToAttribute, which MonoDevelop.Ide also defines and exposes to this assembly
         (InternalsVisibleTo); the local definition is the one used. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HostAnalyzerTests.cs" />
  </ItemGroup>

  <!--
    Not compiled yet: ResultsEditorExtensionTestBase.cs, CodeActionEditorExtensionTestBase.cs and
    MonoDevelop.Refactoring/RenameRefactoringTests.cs derive from TextEditorExtensionTestBase (tests/IdeUnitTests, ported
    by T107), which opens documents through the IDE document manager. They join with it.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../src/core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../../src/addins/MonoDevelop.Refactoring/MonoDevelop.Refactoring.csproj" />
    <!-- GuiUnit is replaced by NUnit 3 (ADR 0015); UnitTests and IdeUnitTests: see the excluded files above. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="NuGet.Frameworks" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- The tests call Roslyn's internal diagnostic analyzer service, as the add-in does (ADR 0010). -->
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Microsoft.CodeAnalysis" />
    <Publicize Include="Microsoft.CodeAnalysis.Workspaces" />
    <Publicize Include="Microsoft.CodeAnalysis.Features" />
  </ItemGroup>
</Project>
