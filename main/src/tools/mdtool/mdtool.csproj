<Project Sdk="Microsoft.NET.Sdk">
  <!--
    mdtool: MonoDevelop's command-line tool host (contracts/mdtool-cli.md), net10.0 (task T062).
    Output: main/build/bin/mdtool.dll, run with `dotnet mdtool.dll <tool> ...`.
  -->
  <PropertyGroup>
    <AssemblyName>mdtool</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/AssemblyInfo.cs" />
    <Compile Include="src/mdtool.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tells Mono.Addins (startup directory = build/bin) where the add-ins are. -->
    <None Include="mdtool.addins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <!-- Headless add-ins that mdtool needs at run time (build them; they are loaded from build/AddIns). -->
    <ProjectReference Include="../../addins/CSharpBinding/MonoDevelop.CSharpBinding.Core/MonoDevelop.CSharpBinding.Core.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../core/MonoDevelop.Projects.Formats.MSBuild/MonoDevelop.MSBuildBuilder.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="Mono.Addins.Setup" />
    <!-- The add-in scanner needs the Cecil reflector on CoreCLR. -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>
</Project>
