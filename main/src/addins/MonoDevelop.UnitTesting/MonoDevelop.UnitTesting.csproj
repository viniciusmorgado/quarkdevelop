    -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Addins" />
    <!--
      VSTest client (FR-011). The legacy build also downloaded the Microsoft.TestPlatform package and shipped its
      .NET Framework vstest.console.exe (run with Mono) in VsTestConsole/: on .NET the add-in drives the vstest.console.dll
      of the .NET SDK instead (VsTestAdapter), the one `dotnet test` uses.
    -->
    <PackageReference Include="Microsoft.TestPlatform.TranslationLayer" />
  </ItemGroup>

  <!--
    Add-ins do not copy their NuGet closure (Common.targets): copy the VSTest client assemblies, which neither the host
    nor another add-in ships. Newtonsoft.Json is the host's (build/bin); NuGet.Frameworks loads from the SDK (ADR 0020).
  -->
  <Target Name="CopyVsTestClient" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.TestPlatform.TranslationLayer' or '%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.TestPlatform.ObjectModel'" />
    </ItemGroup>
  </Target>
