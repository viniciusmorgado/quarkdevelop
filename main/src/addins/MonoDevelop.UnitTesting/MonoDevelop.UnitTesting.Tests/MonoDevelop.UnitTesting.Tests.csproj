<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003); NUnit 3 (ADR 0015), VSTest (T101). -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.UnitTesting.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.UnitTesting.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MonoDevelop.UnitTesting.Tests/TestResultBuilderTests.cs" />
    <Compile Include="MonoDevelop.UnitTesting.Tests/TestProgressMonitor.cs" />
    <Compile Include="MonoDevelop.UnitTesting.Tests/VsTestUnitTestTests.cs" />
    <Compile Include="MonoDevelop.UnitTesting.Tests/UnitTestGroupTests.cs" />
    <Compile Include="MonoDevelop.UnitTesting.Tests/UnitTestingTestSetUp.cs" />
    <Compile Include="MonoDevelop.UnitTesting.Tests/VsTestEndToEndTests.cs" />
  </ItemGroup>

  <!--
    Not compiled: BasicTests.cs (discovery of the .NET Framework / .NET Core 1.x xUnit projects of
    tests/test-projects/unit-testing-addin, restored with the nuget.exe of Mono from nuget.org; ignored upstream as
    randomly failing). VsTestEndToEndTests covers discovery and runs of NUnit, xUnit and MSTest projects (FR-011).
  -->

  <ItemGroup>
    <ProjectReference Include="../../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <!-- Brings the add-in and its dependencies (PackageManagement, Refactoring, DesignerSupport) into the test folder. -->
    <ProjectReference Include="../MonoDevelop.UnitTesting.csproj" />
    <!-- C# project support (the language binding add-in of the project model), registered from the test folder. -->
    <ProjectReference Include="../../CSharpBinding/MonoDevelop.CSharpBinding.Core/MonoDevelop.CSharpBinding.Core.csproj" />
    <!-- An add-in dependency of MonoDevelop.Refactoring (not a project reference of the add-ins). -->
    <ProjectReference Include="../../MonoDevelop.RegexToolkit/MonoDevelop.RegexToolkit.csproj" />
    <!-- UnitTests.TestHost initializes the MonoDevelop runtime (GuiUnit and mdtool run-md-tests did it before, ADR 0015). -->
    <ProjectReference Include="../../../../tests/UnitTests/UnitTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <!-- Mono.Addins scans the add-ins of the test folder with Cecil on .NET (UnitTestingTestSetUp). -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The packages of the FR-011 sample test projects (tests/unittesting-samples), with their dependencies: the solution
    restore downloads them into the global packages folder, from which VsTestEndToEndTests restores the samples with no
    package source (no network in tests). Keep in sync with the sample projects.
  -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.NET.Test.Sdk" Version="[18.10.1]" />
    <PackageDownload Include="Microsoft.CodeCoverage" Version="[18.10.1]" />
    <PackageDownload Include="Microsoft.TestPlatform.TestHost" Version="[18.10.1]" />
    <PackageDownload Include="Microsoft.TestPlatform.ObjectModel" Version="[18.9.0];[18.10.1]" />
    <PackageDownload Include="NUnit" Version="[3.14.0]" />
    <PackageDownload Include="NUnit3TestAdapter" Version="[4.6.0]" />
    <PackageDownload Include="NETStandard.Library" Version="[2.0.0]" />
    <PackageDownload Include="Microsoft.NETCore.Platforms" Version="[1.1.0]" />
    <PackageDownload Include="xunit" Version="[2.9.3]" />
    <PackageDownload Include="xunit.abstractions" Version="[2.0.3]" />
    <PackageDownload Include="xunit.analyzers" Version="[1.18.0]" />
    <PackageDownload Include="xunit.assert" Version="[2.9.3]" />
    <PackageDownload Include="xunit.core" Version="[2.9.3]" />
    <PackageDownload Include="xunit.extensibility.core" Version="[2.9.3]" />
    <PackageDownload Include="xunit.extensibility.execution" Version="[2.9.3]" />
    <PackageDownload Include="xunit.runner.visualstudio" Version="[3.1.5]" />
    <PackageDownload Include="MSTest.TestAdapter" Version="[4.4.1]" />
    <PackageDownload Include="MSTest.TestFramework" Version="[4.4.1]" />
    <PackageDownload Include="MSTest.Analyzers" Version="[4.4.1]" />
    <PackageDownload Include="Microsoft.Testing.Platform" Version="[2.4.1]" />
    <PackageDownload Include="Microsoft.Testing.Platform.MSBuild" Version="[2.4.1]" />
    <PackageDownload Include="Microsoft.Testing.Extensions.Telemetry" Version="[2.4.1]" />
    <PackageDownload Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="[2.4.1]" />
    <PackageDownload Include="Microsoft.ApplicationInsights" Version="[2.23.0]" />
  </ItemGroup>
</Project>
