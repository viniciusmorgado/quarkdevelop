<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converted from the legacy fsproj (ADR 0003): F# language-service helpers shared by the F# add-in, the F#
       Interactive host and the tests. -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.FSharp.Shared</AssemblyName>
    <RootNamespace>MonoDevelop.FSharp.Shared</RootNamespace>
    <AddinBuildDir>FSharpBinding</AddinBuildDir>
    <!-- FSharp.Core comes from Directory.Packages.props (the version FSharp.Compiler.Service 31 was built with). -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="KeywordList.fs" />
    <Compile Include="FSharpSymbolHelper.fs" />
    <Compile Include="ParameterHinting.fs" />
    <Compile Include="Completions.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FSharp.Compiler.Service" />
    <PackageReference Include="ExtCore" NoWarn="NU1701" />
  </ItemGroup>
</Project>
