<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003).
    Debug Adapter Protocol client (VSCodeDebuggerSession); engines such as netcoredbg build on it (ADR 0016).
  -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.Debugger.VsCodeDebugProtocol</AssemblyName>
    <RootNamespace>MonoDevelop.Debugger.VsCodeDebugProtocol</RootNamespace>
    <AddinBuildDir>MonoDevelop.Debugger.VsCodeDebugProtocol</AddinBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AddinInfo.cs" />
    <Compile Include="VSCodeDebuggerSession.cs" />
    <Compile Include="VsCodeStackFrame.cs" />
    <Compile Include="VsCodeObjectSource.cs" />
    <Compile Include="VsCodeBacktrace.cs" />
    <Compile Include="VSCodeVariableSource.cs" />
    <Compile Include="VSCodeEvaluationSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" Private="false" />
    <ProjectReference Include="../../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" Private="false" />
    <ProjectReference Include="../../MonoDevelop.Debugger/MonoDevelop.Debugger.csproj" Private="false" />
    <ProjectReference Include="../../../../vendor/debugger-libs/Mono.Debugging/Mono.Debugging.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Shared.VsCodeDebugProtocol" />
    <PackageReference Include="Newtonsoft.Json" ExcludeAssets="runtime" />
    <PackageReference Include="Mono.Addins" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    The host does not ship the protocol assembly: copy it next to the add-in, as the legacy
    IncludeCopyLocal did (add-ins do not copy their NuGet closure, see Common.targets).
  -->
  <Target Name="CopyDebugProtocolAssembly" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.VisualStudio.Shared.VsCodeDebugProtocol'" />
    </ItemGroup>
  </Target>
</Project>
