<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GNOME/freedesktop platform service of the IDE on Linux (task T087): gio file types and default
    applications, xdg-open, terminals. net10.0; the P/Invokes resolve through NativeLibraryMap
    (GnomePlatform.dll.config is gone, ADR 0013). Output: main/build/bin (next to the IDE, as before).
  -->
  <PropertyGroup>
    <AssemblyName>GnomePlatform</AssemblyName>
    <RootNamespace>MonoDevelop.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GnomePlatform.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Gio.cs" />
    <Compile Include="AddinInfo.cs" />
    <Compile Include="GnomeNativeLibraries.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GnomePlatform.addin.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" Private="false" />
    <ProjectReference Include="../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" Private="false" />
    <ProjectReference Include="../../../vendor/xwt/Xwt/Xwt.csproj" Private="false" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
  </ItemGroup>
</Project>
