<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converted from the legacy csproj by scripts/convert-legacy-csproj.py (ADR 0003); NUnit 3 (ADR 0015), T099. -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.DotNetCore.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.DotNetCore.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="MonoDevelop.DotNetCore.Tests/DotNetCoreTestSetUp.cs" />
    <Compile Include="MonoDevelop.DotNetCore.Tests/DependenciesNodeSdkProjectTests.cs" />
    <Compile Include="MonoDevelop.DotNetCore.Tests/DotNetCoreSdkTemplatesTests.cs" />
    <Compile Include="MonoDevelop.DotNetCore.Tests/DotNetCoreProjectTests.cs" />
