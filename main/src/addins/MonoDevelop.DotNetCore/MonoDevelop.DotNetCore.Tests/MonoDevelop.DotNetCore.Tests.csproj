  </ItemGroup>

  <!--
    Not compiled:
    - MonoDevelop.DotNetCore.Tests/DotNetCoreProjectTemplateTests.cs, TemplateDependencyChecker.cs and the linked
      MonoDevelop.Ide.Templates/TemplateParameter.cs: they derive from ProjectTemplateTest (tests/IdeUnitTests, not ported
      yet: T107) and create every .NET Core 1.x-3.1 template, restoring its packages from nuget.org (no network in tests).
      DotNetCoreSdkTemplatesTests checks that the templates of the installed SDK 10 are listed.
  -->

  <ItemGroup>
    <ProjectReference Include="../../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../MonoDevelop.DotNetCore.csproj" />
    <!-- Brings NuGet.PackageManagement / NuGet.Resolver into the test's deps.json (the rest of NuGet comes from the SDK). -->
    <ProjectReference Include="../../MonoDevelop.PackageManagement/MonoDevelop.PackageManagement.csproj" />
    <!-- C# project support (the language binding add-in of the project model), registered from the test folder. -->
    <ProjectReference Include="../../CSharpBinding/MonoDevelop.CSharpBinding.Core/MonoDevelop.CSharpBinding.Core.csproj" />
    <!-- Add-in dependencies of MonoDevelop.DotNetCore, registered from the test folder (not project references of the add-in). -->
    <ProjectReference Include="../../CSharpBinding/CSharpBinding.csproj" />
    <ProjectReference Include="../../MonoDevelop.RegexToolkit/MonoDevelop.RegexToolkit.csproj" />
    <ProjectReference Include="../../../../vendor/xwt/Xwt/Xwt.csproj" />
    <!-- The .NET debugger engine (netcoredbg) that debugs the projects of the add-in (NetCoreDbgEngineTests). -->
    <ProjectReference Include="../../MonoDevelop.Debugger.NetCoreDbg/MonoDevelop.Debugger.NetCoreDbg.csproj" />
    <!-- UnitTests.TestHost initializes the MonoDevelop runtime (GuiUnit and mdtool run-md-tests did it before, ADR 0015). -->
    <ProjectReference Include="../../../../tests/UnitTests/UnitTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <!-- Mono.Addins scans the add-ins of the test folder with Cecil on .NET (DotNetCoreTestSetUp). -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
