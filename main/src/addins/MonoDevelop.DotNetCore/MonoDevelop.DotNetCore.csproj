  <!--
    Not compiled on Linux (as in the legacy project, which did not compile it either):
    - MonoDevelop.DotNetCore.UnitTesting/DotNetCoreTestPlatformAdapter.cs: VSTest adapter of MonoDevelop.UnitTesting (T101).
    Not compiled on .NET (SDK discovery is Core's DotNetCoreTargetRuntime / DotNetCoreSdkInfo, ADR 0007/0008):
    - MonoDevelop.DotNetCore/MSBuildSdks.cs: the .NET Core 1.0 SDKs bundled with Mono's MSBuild (MSBuild/Sdks). MSBuild
      on .NET is the installed SDK's, which DotNetCoreSdk already finds; System Information shows the SDK directory Core
      builds with instead.
    - MonoDevelop.DotNetCore/MSBuildSdksPathGlobalPropertyProvider.cs: set MSBuildSDKsPath for SDKs older than 1.0.4 or
      for Mono's bundled SDKs; the SDK's MSBuild sets it itself.
    Removed:
    - The legacy DownloadNupkg items (.NET Core 1.x / 2.0 project templates from 2017), the template registrations,
      the template wizard (target framework page) and the template images: the New Project and New File dialogs list
      the templates of `dotnet new` and create projects with the CLI (T152, ADR 0026, MonoDevelop.Ide.Templates).
  -->

  <ItemGroup>
    <EmbeddedResource Include="Properties/MonoDevelop.DotNetCore.addin.xml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonoDevelop.AspNetCore" />
    <InternalsVisibleTo Include="DotNetCore.Debugger" />
    <InternalsVisibleTo Include="MonoDevelop.UnitTesting" />
    <InternalsVisibleTo Include="MonoDevelop.DotNetCore.Tests" />
    <InternalsVisibleTo Include="Xamarin.Forms.Addin" />
    <InternalsVisibleTo Include="MonoDevelop.AzureFunctions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The debugger add-ins are add-in dependencies (the .NET debugger engine, netcoredbg, is T112); the add-in does not
      register a debugger engine yet.
    -->
    <ProjectReference Include="../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" Private="false" />
    <ProjectReference Include="../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" Private="false" />
    <ProjectReference Include="../MonoDevelop.Debugger/MonoDevelop.Debugger.csproj" Private="false" />
    <ProjectReference Include="../../../vendor/debugger-libs/Mono.Debugging/Mono.Debugging.csproj" Private="false" />
    <ProjectReference Include="../MonoDevelop.Debugger.VSCodeDebugProtocol/MonoDevelop.Debugger.VsCodeDebugProtocol/MonoDevelop.Debugger.VsCodeDebugProtocol.csproj" Private="false" />
    <ProjectReference Include="../MonoDevelop.PackageManagement/MonoDevelop.PackageManagement.csproj" Private="false" />
    <ProjectReference Include="../../../vendor/xwt/Xwt/Xwt.csproj" Private="false" />
    <ProjectReference Include="../MonoDevelop.DesignerSupport/MonoDevelop.DesignerSupport.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GtkSharp, Newtonsoft.Json and the template engine come transitively from MonoDevelop.Ide; the NuGet client
      assemblies are compile-only and load from the .NET SDK (ADR 0020, Common.targets): the add-in ships none.
    -->
    <PackageReference Include="Mono.Addins" />
  </ItemGroup>
</Project>
