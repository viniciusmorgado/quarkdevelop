<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converted from the legacy csproj (ADR 0003); NUnit 3 (ADR 0015); netcoredbg tests (ADR 0016, T113). -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop.Debugger.Tests</AssemblyName>
    <RootNamespace>MonoDevelop.Debugger.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DebuggerTestSetUp.cs" />
    <Compile Include="NetCoreDbgTests.cs" />
    <Compile Include="VsCodeStackFrameTests.cs" />
  </ItemGroup>

  <!--
    Not compiled (Mono soft debugger / Win32 engines, excluded on Linux by ADR 0017):
    - main/external/debugger-libs/UnitTests/Mono.Debugging.Tests/Shared/**, DebugTests.MonoDevelop.cs and
      BreakpointsAndSteppingTests.cs: the shared debugger-libs suite drives Mono.Debugger.Soft / CorDebug sessions on
      .NET Framework test apps built with nuget + msbuild. NetCoreDbgTests covers the .NET engine (netcoredbg).
    - TextFile.cs: a text fixture of that suite.
    Not compiled (not ported yet):
    - ObjectValueTreeViewControllerTests.cs: the fake nodes deliver their values through the IDE main loop (GuiUnit ran
      it); under the test host no node is appended. It also waits 8 s on timers.
  -->

  <ItemGroup>
    <ProjectReference Include="../../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <ProjectReference Include="../MonoDevelop.Debugger.csproj" />
    <ProjectReference Include="../../MonoDevelop.Debugger.VSCodeDebugProtocol/MonoDevelop.Debugger.VsCodeDebugProtocol/MonoDevelop.Debugger.VsCodeDebugProtocol.csproj" />
    <ProjectReference Include="../../MonoDevelop.Debugger.NetCoreDbg/MonoDevelop.Debugger.NetCoreDbg.csproj" />
    <ProjectReference Include="../../../../vendor/debugger-libs/Mono.Debugging/Mono.Debugging.csproj" />
    <!-- UnitTests.TestHost initializes the MonoDevelop runtime (GuiUnit and mdtool run-md-tests did it before, ADR 0015). -->
    <ProjectReference Include="../../../../tests/UnitTests/UnitTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GtkSharp" />
    <PackageReference Include="Mono.Addins" />
    <!-- Mono.Addins scans the add-ins of the test folder with Cecil on .NET (DebuggerTestSetUp). -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.VisualStudio.Shared.VsCodeDebugProtocol" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
