  <ItemGroup>
    <EmbeddedResource Include="MonoDevelop.VersionControl.Git.addin.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GitIgnore.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Not compiled: CredentialsDialog.cs and Gui/MonoDevelop.VersionControl.Git.CredentialsDialog.cs (the old Stetic dialog;
    nothing creates it since XwtCredentialsDialog replaced it, and it used the fork's SSH credential types).
    Not used on Linux: MonoDevelop.VersionControl.Git.Win32.addin.xml (Windows-only manifest importing git2-*.dll),
    build_libgit2.sh (built libgit2 from the removed main/external/libgit2 submodule) and the libgit-binary
    license files (that submodule is removed too; the LibGit2Sharp.NativeBinaries package carries its own notices).
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="MonoDevelop.VersionControl.Git.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../core/MonoDevelop.Core/MonoDevelop.Core.csproj" Private="false" />
    <ProjectReference Include="../../../core/MonoDevelop.Ide/MonoDevelop.Ide.csproj" Private="false" />
    <ProjectReference Include="../MonoDevelop.VersionControl/MonoDevelop.VersionControl.csproj" Private="false" />
    <ProjectReference Include="../../../../vendor/xwt/Xwt/Xwt.csproj" Private="false" />
    <ProjectReference Include="../../MonoDevelop.SourceEditor2/MonoDevelop.SourceEditor.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Addins" />
    <!-- nuget.org LibGit2Sharp replaces the main/external/libgit2sharp fork and the libgit2/libgit-binary submodules. -->
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>

  <!--
    The host does not ship LibGit2Sharp: copy it and its native libgit2 builds (runtimes/<rid>/native/) next to the
    add-in (add-ins do not copy their NuGet closure, see Common.targets). GitNativeLibrary resolves libgit2 from the
    add-in's runtimes/ folder, which is not in the host's deps.json.
  -->
  <Target Name="CopyLibGit2Sharp" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'LibGit2Sharp'" />
      <ReferenceCopyLocalPaths Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'LibGit2Sharp.NativeBinaries' and $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux'))" />
    </ItemGroup>
  </Target>
</Project>
