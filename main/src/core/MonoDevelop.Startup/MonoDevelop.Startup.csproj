<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The IDE executable (task T086): main/build/bin/MonoDevelop.dll, started with `dotnet MonoDevelop.dll`
    (scripts/run.sh). net10.0, Linux only; the Windows icon, manifest and LargeAddressAware are gone.
  -->
  <PropertyGroup>
    <AssemblyName>MonoDevelop</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MonoDevelop.Startup/MonoDevelopMain.cs" />
    <Compile Include="AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tells Mono.Addins (startup directory = build/bin) where the add-ins are. -->
    <None Include="MonoDevelop.exe.addins" Link="MonoDevelop.addins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MonoDevelop.Core/MonoDevelop.Core.csproj" />
    <ProjectReference Include="../MonoDevelop.Ide/MonoDevelop.Ide.csproj" />
    <!-- Add-ins the IDE needs at run time (built here, loaded from build/AddIns). -->
    <ProjectReference Include="../../addins/CSharpBinding/MonoDevelop.CSharpBinding.Core/MonoDevelop.CSharpBinding.Core.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../MonoDevelop.Projects.Formats.MSBuild/MonoDevelop.MSBuildBuilder.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../addins/GnomePlatform/GnomePlatform.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="Mono.Addins.Setup" />
    <!-- The add-in scanner needs the Cecil reflector on CoreCLR. -->
    <PackageReference Include="Mono.Addins.CecilReflector" />
    <PackageReference Include="Microsoft.Build.Locator" />
  </ItemGroup>
</Project>
