<Project>
  <!--
    Central package versions for the Linux / .NET 10 build (ADR 0004).
    Only SDK-style projects (the ones in MonoDevelop.Linux.sln) use central package management;
    legacy csproj files keep their own versions until they are converted.
  -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Roslyn internals are consumed through Krafs.Publicizer: pin exactly (ADR 0010). -->
    <RoslynVersion>5.9.0</RoslynVersion>
    <!-- Must not exceed the MSBuild shipped with the pinned SDK (18.9.x in SDK 10.0.4xx). -->
    <MSBuildPackageVersion>18.9.6</MSBuildPackageVersion>
    <!--
      NuGet client (ADR 0020): the version the pinned SDK ships (SDK 10.0.4xx: NuGet 7.9). The assemblies the SDK
      carries are compile-only and load from the SDK at run time, like MSBuild (ADR 0008); only NuGet.PackageManagement,
      NuGet.Resolver and Microsoft.Web.Xdt ship with the MonoDevelop.PackageManagement add-in.
    -->
    <NuGetClientVersion>7.9.0</NuGetClientVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsingMicrosoftNETSdk)' == 'true'">
    <!-- Add-in engine (ADR 0006) -->
    <PackageVersion Include="Mono.Addins" Version="1.4.1" />
    <PackageVersion Include="Mono.Addins.Setup" Version="1.4.1" />
    <PackageVersion Include="Mono.Addins.CecilReflector" Version="1.4.1" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />

    <!-- Platform interop (ADR 0013, ADR 0014) -->
    <PackageVersion Include="Mono.Unix" Version="7.1.0-final.1.21458.1" />
    <PackageVersion Include="NGettext" Version="0.6.7" />

    <!-- MSBuild hosting (ADR 0008) -->
    <PackageVersion Include="Microsoft.Build" Version="$(MSBuildPackageVersion)" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="$(MSBuildPackageVersion)" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="$(MSBuildPackageVersion)" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="$(MSBuildPackageVersion)" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="$(MSBuildPackageVersion)" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />

    <!-- Roslyn (ADR 0010) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Features" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="[$(RoslynVersion)]" />
    <PackageVersion Include="Krafs.Publicizer" Version="2.3.2" />

    <!-- Libraries used by the core -->
    <PackageVersion Include="System.CodeDom" Version="10.0.12" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <PackageVersion Include="System.ComponentModel.Composition" Version="10.0.12" />
    <PackageVersion Include="StreamJsonRpc" Version="2.25.29" />
    <PackageVersion Include="Microsoft.VisualStudio.Composition" Version="17.13.41" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="18.7.23" />
    <PackageVersion Include="Microsoft.VisualStudio.Validation" Version="17.13.22" />
    <PackageVersion Include="Microsoft.VisualStudio.ImageCatalog" Version="17.14.40260" />
    <PackageVersion Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="GtkSharp" Version="3.24.24.95" />
    <PackageVersion Include="Microsoft.TemplateEngine.Edge" Version="10.0.401" />
    <PackageVersion Include="Microsoft.TemplateEngine.Orchestrator.RunnableProjects" Version="10.0.401" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />

    <!--
      NuGet client (ADR 0020). Every package of the client is pinned (Microsoft.TemplateEngine.Edge brings NuGet 6.13
      into the Ide otherwise). The ones the .NET SDK carries are compile-only in all projects (msbuild/Linux/Common.targets).
    -->
    <PackageVersion Include="NuGet.Commands" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Common" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Configuration" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Credentials" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.DependencyResolver.Core" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Frameworks" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.LibraryModel" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.PackageManagement" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Packaging" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.ProjectModel" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Protocol" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Resolver" Version="$(NuGetClientVersion)" />
    <PackageVersion Include="NuGet.Versioning" Version="$(NuGetClientVersion)" />
    <!-- NuGet.Packaging's signing dependency: the hosts ship it (it is not in the shared framework); keep it at the
         runtime's version so the SDK's NuGet (built against 8.0 today) always binds to it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />

    <!-- Version control (T102): nuget.org LibGit2Sharp with its native libgit2 (LibGit2Sharp.NativeBinaries) -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />

    <!--
      Unit testing (T101, FR-011): the VSTest client (VsTestConsoleWrapper) that drives the vstest.console of the .NET
      SDK in design mode. Same release as Microsoft.NET.Test.Sdk; the protocol version is negotiated with the SDK's
      vstest.console, which may be older or newer.
    -->
    <PackageVersion Include="Microsoft.TestPlatform.TranslationLayer" Version="18.10.1" />

    <!-- Debugger: Debug Adapter Protocol client (ADR 0016); netstandard2.0, latest stable on nuget.org -->
    <PackageVersion Include="Microsoft.VisualStudio.Shared.VsCodeDebugProtocol" Version="18.0.10427.1" />

    <!-- Assembly browser (T093): ILSpy's metadata-based decompiler (no Mono.Cecil); netstandard2.0, latest stable -->
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />

    <!-- Tests (ADR 0015) -->
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Castle.Core" Version="5.2.1" />
  </ItemGroup>
</Project>
